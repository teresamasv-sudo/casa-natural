---
---
<html lang="es">
    <link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500&display=swap" rel="stylesheet">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>CASA NATURAL</title>
  </head>
  <body>
    <audio id="ambiente" loop>
    ...
    </audio>

<script>
     window.addEventListener(
    "click",
    () => {
      const audio = document.getElementById("ambiente");

      if (audio instanceof HTMLAudioElement) {
        audio.volume = 0.05;
        audio.play();
      }
    },
    { once: true }
  );
</script>
<section class="hero-cocina">
  <div class="overlay"></div>

  <div class="hero-content">
    <p class="eyebrow">CASA NATURAL</p>

    <h1>
Todavía fermentan<br>
cosas aquí.
   </h1>

    <a href="#contenido" class="hero-button">
      Abrir la casa
    </a>
  </div>

  <div class="season">
    MAYO · harina tibia · ventanas abiertas · olivo · fermento
  </div>
</section>

<style>
  .hero-cocina {
    position: relative;
    height: 100vh;
    background-image: url('/hero-cocina.jpeg');
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: center;
    padding: 6rem;
    color: #f3efe6;
    overflow: hidden;
    animation: fadeHero 1.8s ease;
}

  .overlay {
  position: absolute;
  inset: 0;
backdrop-filter: blur(0.4px);
mix-blend-mode: multiply;
  background:
    linear-gradient(
      to bottom,
      rgba(20, 14, 10, 0.10),
      rgba(20, 14, 10, 0.28)
    );
}

  .hero-content {
    position: relative;
    z-index: 2;
   max-width: 420px;
    margin-top: 10vh;
  }

  .eyebrow {
    font-family: "Courier New", monospace;
    letter-spacing: 0.2em;
    font-size: 0.75rem;
    margin-bottom: 1.5rem;
    opacity: 0.8;
  }
  h1 {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(2.4rem, 6vw, 4.8rem);
  line-height: 0.92;
  font-weight: 300;
  margin-top: 2vh;
  letter-spacing: -0.04em;
  }
 .hero-button {
    display: inline-block;
     border: 1px solid rgba(243,239,230,0.22);
   padding: 0.8rem 1.3rem;
    text-decoration: none;
    color: #f3efe6;
    font-family: "Courier New", monospace;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    transition: all 0.3s ease;
    backdrop-filter: blur(2px);
  }

  .hero-button:hover {
    background: rgba(243, 239, 230, 0.08);
    border-color: rgba(243, 239, 230, 0.7);
    transform: translateY(-1px);
  }
    

  .season {
    position: absolute;
    bottom: 2rem;
    left: 6rem;
    z-index: 2;

    font-family: "Courier New", monospace;
   font-size: 0.68rem;
    letter-spacing: 0.16em;
    opacity: 0.62;
  }

  @media (max-width: 768px) {
    .hero-cocina {
      padding: 2rem;
      align-items: flex-end;
      padding-bottom: 6rem;
    }

    h1 {
      font-size: 3rem;
    }

    .season {
      left: 2rem;
      right: 2rem;
      bottom: 1.5rem;
      font-size: 0.65rem;
    }
  }
  
</style>


