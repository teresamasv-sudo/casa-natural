---
---
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>CASA NATURAL — La Cocina</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300&family=Courier+Prime&display=swap" rel="stylesheet">

    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body { overflow-x: hidden; }

      /* ── HERO ── */
      .hero-cocina {
        position: relative;
        height: 100vh;
        background-image: url('/hero-cocina.jpeg');
        background-size: cover;
        background-position: center;
        display: flex;
        align-items: center;
        padding: 6rem;
        color: #f3efe6;
        overflow: hidden;
      }

      .overlay {
        position: absolute;
        inset: 0;
        backdrop-filter: blur(0.4px);
        background: linear-gradient(
          to bottom,
          rgba(20, 14, 10, 0.10),
          rgba(20, 14, 10, 0.28)
        );
      }

      .hero-content {
        position: relative;
        z-index: 2;
        max-width: 420px;
        margin-top: 10vh;
      }

      .eyebrow {
        font-family: "Courier New", monospace;
        letter-spacing: 0.2em;
        font-size: 0.75rem;
        margin-bottom: 1.5rem;
        opacity: 0.8;
      }

      h1 {
        font-family: 'Cormorant Garamond', serif;
        font-size: clamp(2.4rem, 6vw, 4.8rem);
        line-height: 0.92;
        font-weight: 300;
        margin-top: 2vh;
        margin-bottom: 2rem;
        letter-spacing: -0.04em;
      }

      .hero-button {
        display: inline-block;
        border: 1px solid rgba(243, 239, 230, 0.22);
        padding: 0.8rem 1.3rem;
        text-decoration: none;
        color: #f3efe6;
        font-family: "Courier New", monospace;
        font-size: 0.68rem;
        letter-spacing: 0.08em;
        transition: all 0.3s ease;
        backdrop-filter: blur(2px);
      }

      .hero-button:hover {
        background: rgba(243, 239, 230, 0.08);
        border-color: rgba(243, 239, 230, 0.7);
        transform: translateY(-1px);
      }

      .season {
        position: absolute;
        bottom: 2rem;
        left: 6rem;
        z-index: 2;
        font-family: "Courier New", monospace;
        font-size: 0.68rem;
        letter-spacing: 0.16em;
        opacity: 0.62;
      }

      /* ── LISTA DE ESPERA ── */
      .fermento-section {
        min-height: 100vh;
        background-image: url(/fermento.webp); 
        background-size: cover;
        background-position: center;
        position: relative;
        display: flex;
        align-items: center;
        padding: 8rem 6rem;
      }

      .fermento-section::before {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(
          to bottom,
          rgba(20, 14, 10, 0.45),
          rgba(20, 14, 10, 0.60)
        );
      }

      .fermento-overlay {
        position: relative;
        z-index: 2;
        max-width: 520px;
        color: #f4efe7;
      }

      .fermento-text {
        font-family: 'Courier Prime', monospace;
        font-size: 1rem;
        line-height: 2;
        color: rgba(244, 239, 231, 0.88);
        margin-bottom: 3rem;
        max-width: 420px;
      }

      .fermento-form {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        max-width: 360px;
      }

      .fermento-form input {
        background: transparent;
        border: 1px solid rgba(255, 255, 255, 0.35);
        padding: 1rem 1.2rem;
        color: #f4efe7;
        font-family: 'Courier Prime', monospace;
        font-size: 0.9rem;
        outline: none;
        backdrop-filter: blur(3px);
      }

      .fermento-form input::placeholder {
        color: rgba(244, 239, 231, 0.5);
      }

      .fermento-form button {
        background: transparent;
        border: 1px solid rgba(255, 255, 255, 0.35);
        color: #f4efe7;
        padding: 1rem;
        font-family: 'Courier Prime', monospace;
        letter-spacing: 0.2em;
        font-size: 0.78rem;
        cursor: pointer;
        transition: all 0.3s ease;
      }

      .fermento-form button:hover {
        background: rgba(255, 255, 255, 0.08);
        border-color: rgba(255, 255, 255, 0.55);
      }

      .success-message {
        margin-top: 2rem;
        font-family: 'Courier Prime', monospace;
        line-height: 2;
        color: rgba(244, 239, 231, 0.8);
      }

      @media (max-width: 768px) {
        .hero-cocina {
          padding: 2rem;
          align-items: flex-end;
          padding-bottom: 6rem;
        }
        h1 { font-size: 3rem; }
        .season {
          left: 2rem;
          right: 2rem;
          bottom: 1.5rem;
          font-size: 0.65rem;
        }
        .fermento-section {
          padding: 6rem 2rem;
        }
      }
    </style>
  </head>

  <body>
    <audio id="ambiente" loop>
      <source src="/audio-siesta.mp3" type="audio/mpeg" />
    </audio>

    <script>
      window.addEventListener("click", () => {
        const audio = document.getElementById("ambiente");
        if (audio instanceof HTMLAudioElement) {
          audio.volume = 0.05;
          audio.play();
        }
      }, { once: true });
    </script>

    <!-- HERO -->
    <section class="hero-cocina">
      <div class="overlay"></div>
      <div class="hero-content">
        <p class="eyebrow">CASA NATURAL</p>
        <h1>
          Todavía fermentan<br>
          cosas aquí.
        </h1>
        <a href="#lista-espera" class="hero-button">
          Abrir la casa
        </a>
      </div>
      <div class="season">
        MAYO · harina tibia · ventanas abiertas · olivo · fermento
      </div>
    </section>

    <!-- LISTA DE ESPERA -->
    <section class="fermento-section" id="lista-espera">
      <div class="fermento-overlay">

        <p class="fermento-text">
          Estamos preparando un tutorial de masa madre.<br /><br />
          Si te suscribes, te avisamos cuando esté listo. Y mientras, te llegan las cartas de Casa Natural — lo que vaya fermentando, creciendo o secándose por aquí.
        </p>

        <form class="fermento-form" id="fermento-form">
          <input
            type="email"
            id="fermento-email"
            placeholder="tu correo"
            required
          />
          <button type="submit">
            SUSCRIBIRME
          </button>
        </form>

        <p class="success-message" id="fermento-success" style="display: none;">
          Ya estás dentro.<br />
          Te avisamos del tutorial y te llegan las cartas de Casa Natural.
        </p>

      </div>
    </section>

   <script>
  const form = document.getElementById('fermento-form');
  const emailInput = document.getElementById('fermento-email');
  const success = document.getElementById('fermento-success');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    try {
      const response = await fetch('/.netlify/functions/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: emailInput.value })
      });

      if (response.ok) {
        form.style.display = 'none';
        success.style.display = 'block';
      } else {
        alert('Algo fue mal. Inténtalo de nuevo.');
      }
    } catch (err) {
      alert('Error de conexión. Inténtalo de nuevo.');
    }
  });
</script>

  </body>
</html>
