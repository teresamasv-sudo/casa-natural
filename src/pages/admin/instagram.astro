---
export const prerender = true;
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Admin Instagram · Casa Natural</title>
    <style>
      :root {
        color-scheme: light;
        --bg: #f5efe8;
        --paper: #fcf8f2;
        --ink: #2f2a25;
        --accent: #8a6a3f;
        --line: #d7c8b3;
      }
      body {
        margin: 0;
        font-family: "Georgia", "Times New Roman", serif;
        background: var(--bg);
        color: var(--ink);
      }
      main {
        max-width: 1080px;
        margin: 0 auto;
        padding: 3rem 1.25rem 4rem;
      }
      h1, h2 {
        font-weight: 600;
        letter-spacing: 0.02em;
      }
      .card {
        border: 1px solid var(--line);
        background: var(--paper);
        padding: 1.25rem;
        margin-bottom: 1.25rem;
        box-shadow: 0 2px 10px rgba(47, 42, 37, 0.03);
      }
      .toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1rem;
      }
      form {
        display: grid;
        gap: 0.8rem;
      }
      label {
        font-family: "Courier New", monospace;
        font-size: 0.8rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
      input, textarea {
        width: 100%;
        border: 1px solid var(--line);
        background: #fffdf9;
        padding: 0.7rem 0.8rem;
        color: var(--ink);
        font: inherit;
        box-sizing: border-box;
      }
      textarea {
        min-height: 96px;
        resize: vertical;
      }
      button {
        border: 1px solid var(--line);
        background: var(--ink);
        color: #fff;
        padding: 0.7rem 1rem;
        font: inherit;
        cursor: pointer;
      }
      table {
        width: 100%;
        border-collapse: collapse;
      }
      th, td {
        padding: 0.7rem;
        border-bottom: 1px solid var(--line);
        text-align: left;
        vertical-align: top;
      }
      .pill {
        display: inline-block;
        border: 1px solid var(--line);
        padding: 0.18rem 0.55rem;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }
      .muted { color: var(--accent); }
      .grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
      .hidden { display: none; }
    </style>
  </head>
  <body>
    <main>
      <div class="toolbar">
        <h1>Admin Instagram · Casa Natural</h1>
        <button id="logoutButton" class="hidden" type="button">Cerrar sesión</button>
      </div>

      <section class="card" id="loginSection">
        <h2>Acceso interno</h2>
        <label for="password">Contraseña</label>
        <input id="password" name="password" type="password" />
        <button id="loginButton" type="button">Entrar</button>
        <p id="message" class="muted"></p>
      </section>

      <section class="card hidden" id="adminPanel">
        <h2>Crear / editar campaña</h2>
        <form id="campaignForm">
          <input type="hidden" id="campaignId" />
          <div class="grid">
            <div>
              <label for="name">Nombre</label>
              <input id="name" name="name" required />
            </div>
            <div>
              <label for="instagramMediaId">Instagram media ID</label>
              <input id="instagramMediaId" name="instagramMediaId" />
            </div>
          </div>
          <div class="grid">
            <div>
              <label for="primaryKeyword">Palabra clave principal</label>
              <input id="primaryKeyword" name="primaryKeyword" />
            </div>
            <div>
              <label for="keywordAliases">Aliases</label>
              <input id="keywordAliases" name="keywordAliases" />
            </div>
          </div>
          <div>
            <label for="starterMessage">Starter DM</label>
            <textarea id="starterMessage" name="starterMessage"></textarea>
          </div>
          <div>
            <label for="followRequestMessage">Follow request</label>
            <textarea id="followRequestMessage" name="followRequestMessage"></textarea>
          </div>
          <div class="grid">
            <div>
              <label for="confirmationText">Texto de confirmación</label>
              <input id="confirmationText" name="confirmationText" />
            </div>
            <div>
              <label for="resourceUrl">URL del recurso</label>
              <input id="resourceUrl" name="resourceUrl" />
            </div>
          </div>
          <div>
            <label for="deliveryMessage">Delivery message</label>
            <textarea id="deliveryMessage" name="deliveryMessage"></textarea>
          </div>
          <div class="grid">
            <div>
              <label><input id="requireFollowFlow" type="checkbox" /> Requiere follow flow</label>
            </div>
            <div>
              <label><input id="active" type="checkbox" /> Activa</label>
            </div>
          </div>
          <button id="saveButton" type="submit">Guardar campaña</button>
        </form>
      </section>

      <section class="card">
        <h2>Campañas</h2>
        <table>
          <thead>
            <tr>
              <th>Campaña</th>
              <th>Keyword</th>
              <th>Media ID</th>
              <th>Estado</th>
              <th>Matching</th>
              <th>Replies</th>
              <th>Deliveries</th>
            </tr>
          </thead>
          <tbody id="campaignTableBody"></tbody>
        </table>
      </section>
    </main>

    <script type="module">
      const passwordInput = document.getElementById('password');
      const messageNode = document.getElementById('message');
      const loginSection = document.getElementById('loginSection');
      const adminPanel = document.getElementById('adminPanel');
      const logoutButton = document.getElementById('logoutButton');
      const form = document.getElementById('campaignForm');
      const tableBody = document.getElementById('campaignTableBody');
      const state = {
        password: sessionStorage.getItem('casa-natural-admin') || '',
        campaigns: [],
      };

      function setMessage(text, isError = false) {
        messageNode.textContent = text;
        messageNode.style.color = isError ? '#8a6a3f' : '#2f2a25';
      }

      function togglePanels(isAuthenticated) {
        loginSection.classList.toggle('hidden', isAuthenticated);
        adminPanel.classList.toggle('hidden', !isAuthenticated);
        logoutButton.classList.toggle('hidden', !isAuthenticated);
      }

      function renderCampaigns() {
        tableBody.innerHTML = '';
        if (!state.campaigns.length) {
          tableBody.innerHTML = '<tr><td colspan="7">No hay campañas todavía.</td></tr>';
          return;
        }

        const rows = state.campaigns.map((campaign) => {
          const metrics = campaign.metrics || {};
          return `
            <tr>
              <td><strong>${campaign.name}</strong><br /><span class="muted">${campaign.resourceUrl || ''}</span></td>
              <td>${campaign.primaryKeyword || ''}</td>
              <td>${campaign.instagramMediaId || ''}</td>
              <td><span class="pill">${campaign.active ? 'Activa' : 'Inactiva'}</span></td>
              <td>${metrics.matching || 0}</td>
              <td>${metrics.replies || 0}</td>
              <td>${metrics.deliveries || 0}</td>
            </tr>
          `;
        });

        tableBody.innerHTML = rows.join('');
      }

      async function request(payload) {
        const response = await fetch('/.netlify/functions/admin', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ ...payload, password: state.password }),
        });
        const data = await response.json().catch(() => ({}));
        if (!response.ok) {
          throw new Error(data.error || 'Error interno');
        }
        return data;
      }

      async function loadCampaigns() {
        const data = await request({ action: 'listCampaigns' });
        state.campaigns = data.campaigns || [];
        renderCampaigns();
      }

      async function login() {
        state.password = passwordInput.value.trim();
        try {
          await request({ action: 'authenticate' });
          sessionStorage.setItem('casa-natural-admin', state.password);
          togglePanels(true);
          setMessage('Sesión iniciada.');
          await loadCampaigns();
        } catch (error) {
          setMessage(error.message, true);
        }
      }

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const payload = {
          action: 'saveCampaign',
          campaign: {
            id: document.getElementById('campaignId').value || '',
            name: document.getElementById('name').value,
            instagramMediaId: document.getElementById('instagramMediaId').value,
            primaryKeyword: document.getElementById('primaryKeyword').value,
            keywordAliases: document.getElementById('keywordAliases').value,
            starterMessage: document.getElementById('starterMessage').value,
            followRequestMessage: document.getElementById('followRequestMessage').value,
            confirmationText: document.getElementById('confirmationText').value,
            deliveryMessage: document.getElementById('deliveryMessage').value,
            resourceUrl: document.getElementById('resourceUrl').value,
            requireFollowFlow: document.getElementById('requireFollowFlow').checked,
            active: document.getElementById('active').checked,
          },
        };

        try {
          await request(payload);
          setMessage('Campaña guardada.');
          form.reset();
          document.getElementById('campaignId').value = '';
          await loadCampaigns();
        } catch (error) {
          setMessage(error.message, true);
        }
      });

      document.getElementById('loginButton').addEventListener('click', login);
      logoutButton.addEventListener('click', () => {
        state.password = '';
        sessionStorage.removeItem('casa-natural-admin');
        passwordInput.value = '';
        setMessage('Sesión cerrada.');
        togglePanels(false);
      });

      if (state.password) {
        togglePanels(true);
        loadCampaigns().catch(() => {
          setMessage('No se pudo cargar la lista de campañas.', true);
        });
      }
    </script>
  </body>
</html>
